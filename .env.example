# ---- Firebase client (safe to expose; SAME project as ResultPeak) ----
#
# EVERY ONE IS REQUIRED AND NONE HAS A DEFAULT. The app throws at boot naming
# whichever is missing (src/lib/firebase/env.ts) rather than falling back to a
# baked-in project id. That matters more here than in most apps: this shares a
# Firebase project with ResultPeak, which is live with a paying school, so a
# silent fallback would point a misconfigured deployment at real exam data.
#
# The project is `resultpilot-ddf7c` in every deployment today. It is still read
# from here rather than written into source, and scripts/test-offline.ts fails
# the build if the literal id reappears in a tracked file.
#
# Read from the Firebase console: Project settings -> General -> Your apps.
# Inlined into the browser bundle at BUILD time, so a change needs a redeploy.
#
# There is deliberately no NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET and no
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID. Firebase Storage is forbidden (it
# would force the shared project onto Blaze) and nothing here sends a push;
# files go to Cloudflare R2 below.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (SERVER ONLY - never prefix NEXT_PUBLIC_) ----
#
# From a service account key: Project settings -> Service accounts -> Generate
# new private key. FIREBASE_PROJECT_ID must name the SAME project as the client
# block above; they are two halves of one configuration, not two projects.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n escapes, wrapped in quotes
FIREBASE_PRIVATE_KEY=""

# ---- AI (SERVER ONLY) ----
GEMINI_API_KEY=
# Use the alias, not a pinned version - Google retires pinned names (see lib/ai/gemini.ts)
GEMINI_MODEL=gemini-flash-latest
AI_PROVIDER=gemini

# ---- File storage: Cloudflare R2 (SERVER ONLY) ----
# Dashboard -> R2 -> create bucket "jdsmartlearn-files", then an API token
# (Object Read & Write, scoped to that bucket). Account ID is on the R2 overview page.
# Browsers upload straight to this bucket, so it ALSO needs a CORS policy and a
# lifecycle rule on uploads/ - see docs/r2-bucket-setup.md, then run
# `npm run check:r2`. Without CORS every upload fails.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jdsmartlearn-files

# ---- Student session signing (SERVER ONLY) ----
# Generate: openssl rand -base64 32
STUDENT_SESSION_SECRET=

# Optional. Model for short submissions, where a heavier one buys no accuracy.
# Falls back to GEMINI_MODEL when unset. Use an alias here too.
GEMINI_MODEL_FAST=gemini-flash-latest

# ---- Internal task calls (SERVER ONLY) ----
# Shared secret the submit route uses to call /api/ai/grade-assignment.
# Without it that route would be an unauthenticated way to spend a school's
# daily AI quota. Grading is skipped entirely when this is unset.
# Generate: openssl rand -base64 32
INTERNAL_TASK_SECRET=

# ---- Limits ----
MAX_GENERATIONS_PER_TUTOR_PER_DAY=20
# Students trigger marking, not tutors, so the per-tutor cap does not bound it.
# This is the ceiling on grading calls per school per day.
MAX_GRADINGS_PER_SCHOOL_PER_DAY=200

# ---- Offline (SERVER ONLY) ----
# How long a student's phone may keep reading saved lessons after its last
# successful sync. Past this the saved lessons are wiped and they must sign in
# again. A school week by default; capped at 30 server-side.
STUDENT_OFFLINE_GRACE_DAYS=7

# ---- ResultPeak cross-links (public URL, not a secret) ----
# The exams and report-card product that shares this Firebase project. Setting
# this turns on the links back: "Results and exams" on the front page and the
# tutor dashboard, and "Exams and results" on the student dashboard. Leave it
# BLANK and every one of those disappears; there is no half-configured state and
# no dead link. The reverse link is VITE_JDSMARTLEARN_URL in the ResultPeak repo.
NEXT_PUBLIC_RESULTPEAK_URL=

# ---- School addresses (SERVER ONLY) ----
#
# Hostname resolution is server-side only, so neither of these is NEXT_PUBLIC_.
# Both are OPTIONAL: unset, every hostname is treated as the platform itself and
# the app behaves exactly as it did before school addresses existed, with
# /s/{slug} and the school cookie deciding. That is the correct behaviour for a
# local checkout and for a preview deployment, and it is why this feature needs
# no configuration to be safe.
#
# THESE ARE JDSMARTLEARN'S OWN VALUES, NOT RESULTPEAK'S. The two products are
# separate Vercel projects and cannot share a hostname, so a school has two
# addresses, one per app, and each app knows only its own. See
# docs/school-addresses.md.

# The zone free school subdomains sit under, covered by one wildcard DNS record.
# A school at `capstone.learn.example.ng` needs no DNS work at all, only a
# schoolDomains document written in ResultPeak. The APEX is ours, never a
# school's. Leave blank until the wildcard record exists.
SCHOOL_DOMAIN_ZONE=

# This deployment's own hostnames, comma separated. Anything listed here is the
# platform and is never looked up as a school address, which is also what keeps
# the shared domain from spending a Firestore read on every visitor. localhost,
# *.vercel.app, *.local and *.test are always treated as platform hosts and do
# not need listing.
PLATFORM_HOSTS=
