# ---- Firebase client (safe to expose; SAME project as ResultPeak) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (SERVER ONLY - never prefix NEXT_PUBLIC_) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n escapes, wrapped in quotes
FIREBASE_PRIVATE_KEY=""

# ---- AI (SERVER ONLY) ----
GEMINI_API_KEY=
# Use the alias, not a pinned version - Google retires pinned names (see lib/ai/gemini.ts)
GEMINI_MODEL=gemini-flash-latest
AI_PROVIDER=gemini

# ---- File storage: Cloudflare R2 (SERVER ONLY) ----
# Dashboard -> R2 -> create bucket "jdsmartlearn-files", then an API token
# (Object Read & Write, scoped to that bucket). Account ID is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jdsmartlearn-files

# ---- Student session signing (SERVER ONLY) ----
# Generate: openssl rand -base64 32
STUDENT_SESSION_SECRET=

# Optional. Model for short submissions, where a heavier one buys no accuracy.
# Falls back to GEMINI_MODEL when unset. Use an alias here too.
GEMINI_MODEL_FAST=gemini-flash-latest

# ---- Internal task calls (SERVER ONLY) ----
# Shared secret the submit route uses to call /api/ai/grade-assignment.
# Without it that route would be an unauthenticated way to spend a school's
# daily AI quota. Grading is skipped entirely when this is unset.
# Generate: openssl rand -base64 32
INTERNAL_TASK_SECRET=

# ---- Limits ----
MAX_GENERATIONS_PER_TUTOR_PER_DAY=20
# Students trigger marking, not tutors, so the per-tutor cap does not bound it.
# This is the ceiling on grading calls per school per day.
MAX_GRADINGS_PER_SCHOOL_PER_DAY=200

# ---- Offline (SERVER ONLY) ----
# How long a student's phone may keep reading saved lessons after its last
# successful sync. Past this the saved lessons are wiped and they must sign in
# again. A school week by default; capped at 30 server-side.
STUDENT_OFFLINE_GRACE_DAYS=7

# ---- ResultPeak cross-links (public URL, not a secret) ----
# The exams and report-card product that shares this Firebase project. Setting
# this turns on the links back: "Results and exams" on the front page and the
# tutor dashboard, and "Exams and results" on the student dashboard. Leave it
# BLANK and every one of those disappears; there is no half-configured state and
# no dead link. The reverse link is VITE_JDSMARTLEARN_URL in the ResultPeak repo.
NEXT_PUBLIC_RESULTPEAK_URL=
